# Local development: copy to .env (also read by Prisma CLI).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/onroad"
NEXTAUTH_URL="http://localhost:3000"
# Generate locally: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Hosting: set these in the provider's environment settings, never in Git.
# DATABASE_URL: PostgreSQL connection string; for serverless use the provider's pooler.
# DIRECT_URL: optional direct PostgreSQL connection for migrations only.
# NEXTAUTH_URL: https://YOUR-PROJECT.vercel.app or https://YOUR-PROJECT.onrender.com
# Preview deployments must have a separate DB, secret and bucket.
# PREVIEW_DATABASE_ISOLATED=true

# Local .data directory is development-only. Production uses vercel-blob or s3.
STORAGE_DRIVER="local"
# Vercel Blob: connect a PRIVATE store to the Production environment.
# The integration supplies BLOB_STORE_ID (OIDC) or BLOB_READ_WRITE_TOKEN.
# STORAGE_DRIVER="vercel-blob"
# BLOB_READ_WRITE_TOKEN=""
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
